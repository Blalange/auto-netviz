# syntax=docker/dockerfile:1

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/collector ./cmd/collector
COPY internal ./internal
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /out/auto-netviz-collector ./cmd/collector

FROM alpine:3.21
RUN apk add --no-cache ca-certificates ipmitool lldpd tzdata && adduser -D -u 1000 app
COPY --from=build /out/auto-netviz-collector /usr/local/bin/auto-netviz-collector
RUN mkdir -p /config /spool && chown -R 1000:1000 /config /spool
USER 1000
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/auto-netviz-collector"]
CMD ["--config", "/config/collector.yaml"]
